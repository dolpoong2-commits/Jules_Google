<Window x:Class="SolidworksStepConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SolidworksStepConverter"
        mc:Ignorable="d"
        Title="SolidWorks to STEP Converter" Height="350" Width="550"
        MinHeight="350" MaxHeight="350" MinWidth="550" MaxWidth="550">

    <Window.Resources>
        <!-- 테마 리소스 딕셔너리 -->

        <!-- 1. 기본 테마 (Default) -->
        <ResourceDictionary x:Key="Theme.Default">
            <SolidColorBrush x:Key="App.Background" Color="#F0F0F0"/>
            <SolidColorBrush x:Key="App.Foreground" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="Button.Background" Color="#DDDDDD"/>
            <SolidColorBrush x:Key="Button.Foreground" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="Button.Border" Color="#CCCCCC"/>
            <SolidColorBrush x:Key="Button.Hover.Background" Color="#BEE6FD"/>
        </ResourceDictionary>

        <!-- 2. 솔라라이즈 테마 (Solarized) -->
        <ResourceDictionary x:Key="Theme.Solarized">
            <SolidColorBrush x:Key="App.Background" Color="#002b36"/>
            <SolidColorBrush x:Key="App.Foreground" Color="#839496"/>
            <SolidColorBrush x:Key="Button.Background" Color="#073642"/>
            <SolidColorBrush x:Key="Button.Foreground" Color="#93a1a1"/>
            <SolidColorBrush x:Key="Button.Border" Color="#586e75"/>
            <SolidColorBrush x:Key="Button.Hover.Background" Color="#268bd2"/>
        </ResourceDictionary>

        <!-- 3. 블랙 테마 (Black) -->
        <ResourceDictionary x:Key="Theme.Black">
            <SolidColorBrush x:Key="App.Background" Color="#121212"/>
            <SolidColorBrush x:Key="App.Foreground" Color="#E0E0E0"/>
            <SolidColorBrush x:Key="Button.Background" Color="#2C2C2C"/>
            <SolidColorBrush x:Key="Button.Foreground" Color="#E0E0E0"/>
            <SolidColorBrush x:Key="Button.Border" Color="#555555"/>
            <SolidColorBrush x:Key="Button.Hover.Background" Color="#444444"/>
        </d:ResourceDictionary>

        <!-- 버튼 스타일 -->
        <Style x:Key="ThemedButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Button.Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource Button.Foreground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Button.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Button.Hover.Background}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid" Background="{DynamicResource App.Background}">
        <StackPanel Margin="20">
            <!-- 상태 표시 -->
            <TextBlock Text="현재 활성화된 파일:" Foreground="{DynamicResource App.Foreground}" FontSize="14"/>
            <Border BorderBrush="{DynamicResource Button.Border}" BorderThickness="1" CornerRadius="5" Margin="0,5,0,0" Padding="10" MinHeight="40">
                <TextBlock x:Name="ActiveFileNameTextBlock" Text="SolidWorks를 실행하고 어셈블리 파일을 열어주세요..." Foreground="{DynamicResource App.Foreground}" TextWrapping="Wrap"/>
            </Border>

            <!-- STEP 변환 버튼 -->
            <Button x:Name="ConvertButton" Content="활성 어셈블리를 STEP으로 변환" Style="{StaticResource ThemedButton}" Margin="0,20,0,0" Padding="15" Click="ConvertButton_Click"/>

            <!-- 구분선 -->
            <Separator Margin="0,30,0,10"/>

            <!-- 테마 선택 -->
            <TextBlock Text="테마 선택:" Foreground="{DynamicResource App.Foreground}" FontSize="14" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="DefaultThemeButton" Content="기본" Style="{StaticResource ThemedButton}" Width="100" Click="DefaultThemeButton_Click"/>
                <Button x:Name="SolarizedThemeButton" Content="솔라라이즈" Style="{StaticResource ThemedButton}" Width="100" Margin="10,0,0,0" Click="SolarizedThemeButton_Click"/>
                <Button x:Name="BlackThemeButton" Content="블랙" Style="{StaticResource ThemedButton}" Width="100" Margin="10,0,0,0" Click="BlackThemeButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>