# --- Telegram Bot Configuration ---
# Your free Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN="your-telegram-bot-token-here"
# Your numeric Telegram User ID to restrict access
TELEGRAM_USER_ID="123456789"

# --- HuggingFace Configuration ---
# Required to download restricted/gated models like Llama or Exaone
HF_TOKEN="your-huggingface-token-here"

# --- LiteLLM Configuration ---
# The master key used for internal routing between the bot and LiteLLM proxy
LITELLM_MASTER_KEY="sk-local-secure-key"

# --- External API Keys for MCP Tools ---
GITHUB_PERSONAL_ACCESS_TOKEN="your-github-token-here"

# --- Database Configuration ---
POSTGRES_USER="agent_user"
POSTGRES_PASSWORD="secure_agent_password_here"

# --- System Paths ---
# Absolute path to the workspace directory where the agent will write code
WORKSPACE_DIR="/home/david/workspace"
# Path to local SQLite agent database (if not using Postgres)
AGENT_DB_PATH="/home/david/agent.db"
